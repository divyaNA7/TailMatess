  <!-- Firebase -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>

  <script>
    // ==========================================
    // FIREBASE CONFIG
    // ==========================================
    // For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBifu5Te7paXOFUFrDUtogIPpi5H0xR7rY",
  authDomain: "tailmatess.firebaseapp.com",
  projectId: "tailmatess",
  storageBucket: "tailmatess.firebasestorage.app",
  messagingSenderId: "445299543083",
  appId: "1:445299543083:web:e7be85a3eae32f8ba5ee6e",
  measurementId: "G-ZLQG062LVE"
};
    let db, auth, currentUser, conversationId, unsubMessages;
    let firebaseReady = false;

    try {
      firebase.initializeApp(firebaseConfig);
      auth = firebase.auth();
      db = firebase.firestore();
      firebaseReady = true;
    } catch (e) {
      console.log("Firebase not configured - demo mode");
    }

    // ==========================================
    // STATE
    // ==========================================
    const urlParams = new URLSearchParams(window.location.search);
    const petId = urlParams.get('pet') || 'bruno-001';
    const petName = urlParams.get('name') || 'Bruno';
    const petBreed = urlParams.get('breed') || 'Golden Retriever';
    const listerId = urlParams.get('lister') || 'lister_demo';
    const adopterId = urlParams.get('adopter') || 'adopter_demo';
    const matchScore = urlParams.get('match') || '92';
    const myRole = urlParams.get('role') || localStorage.getItem('tm_role') || 'adopter';

    let selectedSpot = null;
    let selectedTime = null;

    // Voice recording state
    let mediaRecorder = null;
    let audioChunks = [];
    let recordStartTime = null;
    let recordTimerInterval = null;
    let recordedAudioBlob = null;
    let recordedAudioUrl = null;
    let isRecording = false;

    // ==========================================
    // VOICE RECORDING
    // ==========================================
    async function startRecording() {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        alert("Voice recording is not supported in this browser.");
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const mimeType = MediaRecorder.isTypeSupported('audio/webm') ? 'audio/webm' : 'audio/mp4';
        mediaRecorder = new MediaRecorder(stream, { mimeType });
        audioChunks = [];
        isRecording = true;

        mediaRecorder.ondataavailable = (e) => {
          if (e.data && e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          recordedAudioBlob = new Blob(audioChunks, { type: mimeType });
          recordedAudioUrl = URL.createObjectURL(recordedAudioBlob);
          // Stop all tracks to release the mic
          stream.getTracks().forEach(t => t.stop());
        };

        mediaRecorder.onerror = (e) => {
          console.error("MediaRecorder error:", e);
          stopRecordingUI();
        };

        mediaRecorder.start(100); // collect data every 100ms
        showRecordingUI();
      } catch (err) {
        console.error("Microphone access denied or error:", err);
        alert("Could not access microphone. Please allow microphone permissions.");
      }
    }

    function showRecordingUI() {
      document.getElementById('record-overlay').classList.add('active');
      document.getElementById('mic-btn').classList.add('recording');
      recordStartTime = Date.now();
      updateRecordTimer();
      recordTimerInterval = setInterval(updateRecordTimer, 1000);
      animateRecordWave();
    }

    function stopRecordingUI() {
      document.getElementById('record-overlay').classList.remove('active');
      document.getElementById('mic-btn').classList.remove('recording');
      clearInterval(recordTimerInterval);
      recordStartTime = null;
      isRecording = false;
    }

    function updateRecordTimer() {
      if (!recordStartTime) return;
      const elapsed = Math.floor((Date.now() - recordStartTime) / 1000);
      const mins = String(Math.floor(elapsed / 60)).padStart(2, '0');
      const secs = String(elapsed % 60).padStart(2, '0');
      const el = document.getElementById('record-timer');
      if (el) el.textContent = `${mins}:${secs}`;
    }

    function animateRecordWave() {
      const container = document.getElementById('record-wave');
      if (!container) return;
      container.innerHTML = '';
      const barCount = 20;
      const bars = [];
      for (let i = 0; i < barCount; i++) {
        const bar = document.createElement('div');
        bar.className = 'bar';
        bar.style.height = '8px';
        container.appendChild(bar);
        bars.push(bar);
      }
      const interval = setInterval(() => {
        if (!isRecording) { clearInterval(interval); return; }
        bars.forEach(bar => {
          const h = Math.floor(Math.random() * 40) + 4;
          bar.style.height = h + 'px';
        });
      }, 120);
    }

    function stopRecording() {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      stopRecordingUI();
      if (recordedAudioBlob && recordedAudioBlob.size > 0) {
        sendVoiceMessage(recordedAudioBlob);
      }
      recordedAudioBlob = null;
      recordedAudioUrl = null;
    }

    function cancelRecording() {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      // Discard the blob
      recordedAudioBlob = null;
      recordedAudioUrl = null;
      audioChunks = [];
      stopRecordingUI();
    }

    // ==========================================
    // CHAT MESSAGING
    // ==========================================
    const chatMessages = document.getElementById('chat-messages');
    const messageInput = document.getElementById('message-input');

    // Demo conversation data
    const demoMessages = [
      { type: 'received', text: "Hi! I saw you were interested in Buddy. He is a 2-year-old Golden Retriever, very friendly with kids and other dogs.", time: '10:30 AM' },
      { type: 'sent', text: "Yes, he looks adorable! Is he vaccinated?", time: '10:32 AM', read: true },
      { type: 'received', text: "Absolutely. All vaccinations are up to date including rabies. I have the vet records ready.", time: '10:33 AM' },
      { type: 'sent', text: "That\'s great to hear. Would it be okay to meet him this weekend?", time: '10:35 AM', read: true },
      { type: 'received', text: "Sure! I\'m free on Saturday afternoon or Sunday morning. What works for you?", time: '10:36 AM' },
    ];

    function initChat() {
      // Set header info
      document.getElementById('header-name').textContent = `${petName} (${petBreed})`;
      document.getElementById('pet-name').textContent = petName;
      document.getElementById('match-score').textContent = `${matchScore}%`;
      document.title = `Chat - ${petName} | TailMates`;

      // Load messages
      if (firebaseReady) {
        loadMessagesFromFirebase();
      } else {
        loadDemoMessages();
      }
    }

    function loadDemoMessages() {
      demoMessages.forEach(m => addMessageToUI(m.type, m.text, m.time, m.read));
    }

    function sendMessage() {
      const text = messageInput.value.trim();
      if (!text) return;
      messageInput.value = '';
      const time = formatTime(new Date());
      addMessageToUI('sent', text, time, false);
      scrollToBottom();

      if (firebaseReady) {
        saveMessage({ text, type: 'text', sender: myRole, time: new Date() });
      }

      // Simulate reply
      setTimeout(() => {
        showTyping();
        setTimeout(() => {
          removeTyping();
          const reply = getAutoReply(text);
          addMessageToUI('received', reply, formatTime(new Date()), false);
          scrollToBottom();
        }, 1500);
      }, 600);
    }

    function sendVoiceMessage(blob) {
      const duration = estimateDuration(blob);
      const time = formatTime(new Date());
      addVoiceMessageToUI('sent', duration, time);
      scrollToBottom();

      if (firebaseReady) {
        // In real app, upload blob to Firebase Storage, then save URL
        saveMessage({ type: 'voice', duration, sender: myRole, time: new Date() });
      }

      // Simulate reply
      setTimeout(() => {
        showTyping();
        setTimeout(() => {
          removeTyping();
          addMessageToUI('received', "Thanks for the voice note! I\'ll listen to it shortly.", formatTime(new Date()), false);
          scrollToBottom();
        }, 1500);
      }, 800);
    }

    function estimateDuration(blob) {
      // Rough estimate: ~0.16KB per second for compressed voice
      const sizeKB = blob.size / 1024;
      const secs = Math.max(1, Math.round(sizeKB / 1.6));
      const m = Math.floor(secs / 60);
      const s = secs % 60;
      return `${m}:${String(s).padStart(2, '0')}`;
    }

    function addMessageToUI(type, text, time, read) {
      const row = document.createElement('div');
      row.className = `msg-row ${type}`;
      row.innerHTML = `
        <div class="msg-bubble">
          <div class="msg-text">${escapeHtml(text)}</div>
          <div class="msg-meta">
            <span class="msg-time">${time}</span>
            ${type === 'sent' ? `<span class="msg-read ${read ? '' : 'pending'}">${read ? '✓✓' : '✓'}</span>` : ''}
          </div>
        </div>
      `;
      chatMessages.appendChild(row);
      scrollToBottom();
    }

    function addVoiceMessageToUI(type, duration, time) {
      const row = document.createElement('div');
      row.className = `msg-row ${type}`;
      const bars = Array.from({ length: 24 }, () => Math.floor(Math.random() * 20) + 4);
      row.innerHTML = `
        <div class="msg-bubble voice-bubble">
          <div class="voice-inner">
            <button class="voice-play-btn" onclick="playVoice(this)">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <div class="voice-waveform">
              ${bars.map((h, i) => `<div class="bar" style="height:${h}px"></div>`).join('')}
            </div>
            <span class="voice-time">${duration}</span>
          </div>
          <div class="msg-meta" style="position:static;justify-content:flex-end;margin-top:0.25rem;">
            <span class="msg-time">${time}</span>
            ${type === 'sent' ? `<span class="msg-read">✓✓</span>` : ''}
          </div>
        </div>
      `;
      chatMessages.appendChild(row);
    }

    function playVoice(btn) {
      // Toggle play icon
      const isPlaying = btn.dataset.playing === 'true';
      btn.dataset.playing = isPlaying ? 'false' : 'true';
      btn.innerHTML = isPlaying
        ? '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>'
        : '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      // Animate waveform bars
      const bars = btn.parentElement.querySelectorAll('.voice-waveform .bar');
      bars.forEach(b => b.classList.toggle('active', !isPlaying));
      if (!isPlaying) {
        setTimeout(() => {
          btn.dataset.playing = 'false';
          btn.innerHTML = '<svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
          bars.forEach(b => b.classList.remove('active'));
        }, 3000);
      }
    }

    function showTyping() {
      if (document.getElementById('typing-indicator')) return;
      const row = document.createElement('div');
      row.id = 'typing-indicator';
      row.className = 'typing-row';
      row.innerHTML = `
        <div class="typing-bubble">
          <div class="typing-dots"><span></span><span></span><span></span></div>
        </div>
      `;
      chatMessages.appendChild(row);
      scrollToBottom();
    }

    function removeTyping() {
      const el = document.getElementById('typing-indicator');
      if (el) el.remove();
    }

    function scrollToBottom() {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function formatTime(date) {
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function getAutoReply(text) {
      const lower = text.toLowerCase();
      if (lower.includes('meet') || lower.includes('weekend') || lower.includes('saturday') || lower.includes('sunday')) {
        return "Perfect! I\'ve sent you the meetup options. You can tap the 📍 icon in the header to schedule it officially.";
      }
      if (lower.includes('vaccin') || lower.includes('health') || lower.includes('medical')) {
        return "Bruno is in excellent health. He was last checked by the vet just last month.";
      }
      if (lower.includes('food') || lower.includes('eat') || lower.includes('diet')) {
        return "He eats Royal Canin Golden Retriever adult food, twice a day. Very disciplined eater!";
      }
      if (lower.includes('price') || lower.includes('cost') || lower.includes('fee') || lower.includes('money')) {
        return "There is no adoption fee. I just want Bruno to go to a loving home. A small donation to an animal shelter would be appreciated though.";
      }
      return "That sounds good! Let me know if you have any other questions about Bruno.";
    }

    // ==========================================
    // MEETUP PANEL
    // ==========================================
    function toggleMeetupPanel() {
      const panel = document.getElementById('meetup-panel');
      const overlay = document.getElementById('panel-overlay');
      const isOpen = panel.classList.contains('open');
      panel.classList.toggle('open', !isOpen);
      overlay.classList.toggle('open', !isOpen);
    }

    function selectSpot(el, name, area) {
      document.querySelectorAll('.spot-card2').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      selectedSpot = { name, area };
      document.getElementById('datetime-section').style.display = 'block';
      // Set default date to tomorrow
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      document.getElementById('meetup-date').valueAsDate = tomorrow;
    }

    function selectTime(btn) {
      document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      selectedTime = btn.textContent;
    }

    function confirmMeetup() {
      const dateVal = document.getElementById('meetup-date').value;
      if (!selectedSpot) { alert('Please select a meetup spot.'); return; }
      if (!dateVal) { alert('Please pick a date.'); return; }
      if (!selectedTime) { alert('Please pick a time slot.'); return; }

      const dateObj = new Date(dateVal);
      const dateStr = dateObj.toLocaleDateString('en-IN', { weekday: 'short', month: 'short', day: 'numeric' });

      // Add system message
      const systemRow = document.createElement('div');
      systemRow.className = 'system-row';
      systemRow.innerHTML = `
        <div class="system-bubble">
          <p>📍 Meetup Scheduled</p>
          <p>${selectedSpot.name} — ${dateStr} at ${selectedTime}</p>
        </div>
      `;
      chatMessages.appendChild(systemRow);
      scrollToBottom();

      // Add confirmation message
      addMessageToUI('received', `Great! I\'ve noted the meetup at ${selectedSpot.name} on ${dateStr} at ${selectedTime}. See you there! 🐕`, formatTime(new Date()), false);

      toggleMeetupPanel();
      selectedSpot = null;
      selectedTime = null;
      document.querySelectorAll('.spot-card2').forEach(c => c.classList.remove('selected'));
      document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
      document.getElementById('datetime-section').style.display = 'none';
    }

    // ==========================================
    // FIREBASE
    // ==========================================
    function loadMessagesFromFirebase() {
      conversationId = [listerId, adopterId, petId].sort().join('_');
      const msgsRef = db.collection('conversations').doc(conversationId).collection('messages').orderBy('time', 'asc');
      unsubMessages = msgsRef.onSnapshot(snapshot => {
        chatMessages.innerHTML = '<div class="date-separator"><span>Today</span></div>';
        snapshot.forEach(doc => {
          const m = doc.data();
          const type = m.sender === myRole ? 'sent' : 'received';
          const time = m.time ? m.time.toDate().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
          if (m.type === 'voice') {
            addVoiceMessageToUI(type, m.duration || '0:00', time);
          } else if (m.type === 'location') {
            addLocationMessageToUI(type, { lat: m.lat, lng: m.lng, name: m.name, address: m.address }, time);
          } else {
            addMessageToUI(type, m.text, time, m.read);
          }
        });
      });
    }

    async function saveMessage(data) {
      if (!db) return;
      conversationId = conversationId || [listerId, adopterId, petId].sort().join('_');
      try {
        await db.collection('conversations').doc(conversationId).collection('messages').add(data);
      } catch (e) {
        console.error("Error saving message:", e);
      }
    }

    // ==========================================
    // EVENT LISTENERS
    // ==========================================
    messageInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });


    // ==========================================
    // MAP / LOCATION SHARING
    // ==========================================
    let map = null;
    let mapMarker = null;
    let selectedLocation = null;
    let searchController = null;

    function toggleMapPanel() {
      const panel = document.getElementById('map-panel');
      const overlay = document.getElementById('map-overlay');
      const isOpen = panel.classList.contains('open');
      panel.classList.toggle('open', !isOpen);
      overlay.classList.toggle('open', !isOpen);
      if (!isOpen) {
        setTimeout(() => initMap(), 100);
      } else {
        selectedLocation = null;
        document.getElementById('map-send-btn').disabled = true;
        document.getElementById('map-results').innerHTML = '';
        document.getElementById('map-results').classList.remove('active');
      }
    }

    function initMap() {
      if (map) {
        map.invalidateSize();
        return;
      }
      const defaultLat = 19.0760; // Mumbai
      const defaultLng = 72.8777;
      map = L.map('leaflet-map').setView([defaultLat, defaultLng], 13);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19
      }).addTo(map);

      // Click to drop pin
      map.on('click', async (e) => {
        const { lat, lng } = e.latlng;
        setMapMarker(lat, lng);
        const address = await reverseGeocode(lat, lng);
        selectedLocation = { lat, lng, name: address.name, address: address.display_name };
        document.getElementById('map-send-btn').disabled = false;
      });

      // Try to locate user
      locateMe();
    }

    function setMapMarker(lat, lng) {
      if (mapMarker) map.removeLayer(mapMarker);
      const customIcon = L.divIcon({
        className: 'custom-pin',
        html: `<div style="width:28px;height:28px;background:#075e54;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,0.3);"><div style="width:10px;height:10px;background:white;border-radius:50%;transform:rotate(45deg);"></div></div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 28]
      });
      mapMarker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
      map.setView([lat, lng], 16);
    }

    function locateMe() {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        async (pos) => {
          const { latitude, longitude } = pos.coords;
          if (!map) return;
          setMapMarker(latitude, longitude);
          const address = await reverseGeocode(latitude, longitude);
          selectedLocation = { lat: latitude, lng: longitude, name: address.name, address: address.display_name };
          document.getElementById('map-send-btn').disabled = false;
        },
        (err) => {
          console.warn('Geolocation error:', err);
          // Stay on default view
        },
        { enableHighAccuracy: true, timeout: 10000 }
      );
    }

    async function searchLocation() {
      const query = document.getElementById('map-search-input').value.trim();
      if (!query) return;
      const resultsContainer = document.getElementById('map-results');
      resultsContainer.innerHTML = '<div style="padding:1rem;text-align:center;color:#9ca3af;font-size:0.8rem;">Searching...</div>';
      resultsContainer.classList.add('active');

      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=5`);
        const data = await res.json();
        resultsContainer.innerHTML = '';
        if (!data || data.length === 0) {
          resultsContainer.innerHTML = '<div style="padding:1rem;text-align:center;color:#9ca3af;font-size:0.8rem;">No places found.</div>';
          return;
        }
        data.forEach(place => {
          const item = document.createElement('div');
          item.className = 'map-result-item';
          item.innerHTML = `
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <div>
              <div class="map-result-name">${escapeHtml(place.display_name.split(',')[0])}</div>
              <div class="map-result-area">${escapeHtml(place.display_name)}</div>
            </div>
          `;
          item.onclick = () => {
            const lat = parseFloat(place.lat);
            const lon = parseFloat(place.lon);
            setMapMarker(lat, lon);
            selectedLocation = { lat, lng: lon, name: place.display_name.split(',')[0], address: place.display_name };
            document.getElementById('map-send-btn').disabled = false;
            resultsContainer.classList.remove('active');
            document.getElementById('map-search-input').value = place.display_name.split(',')[0];
          };
          resultsContainer.appendChild(item);
        });
      } catch (e) {
        console.error('Search error:', e);
        resultsContainer.innerHTML = '<div style="padding:1rem;text-align:center;color:#ef4444;font-size:0.8rem;">Search failed. Try again.</div>';
      }
    }

    async function reverseGeocode(lat, lng) {
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
        const data = await res.json();
        return data;
      } catch (e) {
        return { name: 'Selected Location', display_name: `${lat.toFixed(4)}, ${lng.toFixed(4)}` };
      }
    }

    function sendLocation() {
      if (!selectedLocation) return;
      const time = formatTime(new Date());
      addLocationMessageToUI('sent', selectedLocation, time);
      scrollToBottom();
      toggleMapPanel();

      if (firebaseReady) {
        saveMessage({
          type: 'location',
          lat: selectedLocation.lat,
          lng: selectedLocation.lng,
          name: selectedLocation.name,
          address: selectedLocation.address,
          sender: myRole,
          time: new Date()
        });
      }

      // Simulate reply
      setTimeout(() => {
        showTyping();
        setTimeout(() => {
          removeTyping();
          addMessageToUI('received', `Got your location! I\'ll meet you near ${selectedLocation.name}.`, formatTime(new Date()), false);
          scrollToBottom();
        }, 1500);
      }, 600);
    }

    function addLocationMessageToUI(type, loc, time) {
      const row = document.createElement('div');
      row.className = `msg-row ${type}`;
      const mapImg = `https://static-maps.openstreetmap.org/?center=${loc.lat},${loc.lng}&zoom=15&size=280x140&markers=${loc.lat},${loc.lng}`;
      row.innerHTML = `
        <div class="msg-bubble location-bubble" onclick="openInMaps(${loc.lat}, ${loc.lng})">
          <img class="loc-map-img" src="${mapImg}" alt="Map" onerror="this.style.display='none'">
          <div class="loc-info">
            <div class="loc-name">📍 ${escapeHtml(loc.name || 'Shared Location')}</div>
            <div class="loc-address">${escapeHtml(loc.address || '')}</div>
          </div>
          <div class="loc-meta">
            <span class="msg-time">${time}</span>
            ${type === 'sent' ? `<span class="msg-read">✓✓</span>` : ''}
          </div>
        </div>
      `;
      chatMessages.appendChild(row);
    }

    function openInMaps(lat, lng) {
      const url = `https://www.google.com/maps?q=${lat},${lng}`;
      window.open(url, '_blank');
    }

    // Search on Enter key
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('map-search-input');
      if (searchInput) {
        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') searchLocation();
        });
      }
    });

    // Initialize
    initChat();
  </script>
</body>
</html>

